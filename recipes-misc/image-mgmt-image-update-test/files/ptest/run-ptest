#!/bin/sh

cd "$(dirname "$0")"
echo "Running image-mgmt-image-update ptest"
output=$(python3 image_update_test.py)
ret=$?

if [ "$ret" -ne 0 ] || echo "$output" | grep -qE "FAIL|Unknown"; then
    echo "Test failed: non-zero return ($ret) or output contains FAIL/Unknown"
    echo "$output"
    exit 1
else
    exit 0
fi
